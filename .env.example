QUORUMSCOPE_ENV=development
QUORUMSCOPE_NETWORK=testnet
QUORUMSCOPE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
QUORUMSCOPE_RPC_URL=
QUORUMSCOPE_RPC_HEADERS_JSON={}
