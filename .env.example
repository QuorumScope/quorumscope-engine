# Copy to .env and edit. The quorumscope binary reads these variables.
# Put real credentials only in your own .env, never in this file.
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/quorumscope
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_NAME=testnet
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
POLLING_INTERVAL_SEC=5
LOG_LEVEL=info

# API only
API_BIND=127.0.0.1:8080
# Highest protocol version this release is verified against. Leave unset to report compatibility as unknown.
VERIFIED_PROTOCOL_MAX=
STALE_AFTER_SEC=300
MAX_LAG_LEDGERS=10
# Comma-separated browser origins allowed to call the API. Leave empty to send no CORS headers.
ALLOWED_ORIGINS=

# Report command: path to the typst binary when it is not on PATH.
QUORUMSCOPE_TYPST=
